+for (const f of jsFiles) byFile[f] = extractTopLevelFunctions(jsContents[f]);
+const dead = [];
+for (let i = 0; i < jsFiles.length; i++) {
+  for (let j = 0; j < jsFiles.length; j++) {
+    if (i === j) continue;
+    const a = jsFiles[i], b = jsFiles[j];
